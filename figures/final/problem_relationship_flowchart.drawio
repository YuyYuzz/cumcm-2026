<?xml version="1.0" encoding="UTF-8"?><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="Start: define drying problem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A6FC4;strokeColor=#1A6FC4;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="25" width="260" height="48" as="geometry"/></mxCell><mxCell id="input" value="Read drying-air data, material properties,\nand initial temperature/moisture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#767676;strokeWidth=1.4;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="105" width="400" height="58" as="geometry"/></mxCell><mxCell id="prep" value="Preprocess data and initialize radial grid\n(axis r = 0, surface r = R)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#767676;strokeWidth=1.4;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="285" y="200" width="350" height="58" as="geometry"/></mxCell><mxCell id="q1" value="Q1: coupled heat–moisture model\nfixed geometry; validate T(r,t), C(r,t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#1A6FC4;strokeWidth=1.8;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="285" y="295" width="350" height="64" as="geometry"/></mxCell><mxCell id="q2" value="Q2: fixed-radius drying dynamics\nprofiles, response, diffusivity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#1A6FC4;strokeWidth=1.8;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="285" y="400" width="350" height="64" as="geometry"/></mxCell><mxCell id="q3" value="Q3: global maximum Cmax(t)\nand termination tracking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=